@model Employee

<h2>Edit Employee</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.Id)

    <div class="mb-3">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Position)
        @Html.TextBoxFor(m => m.Position, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Salary)
        @Html.TextBoxFor(m => m.Salary, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.HireDate, "Hire Date")
        @Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}",
            new { @class = "form-control", type = "date" })
    </div>

    <button type="submit" class="btn btn-primary">Update</button>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
}
