@model SupplyRequest

@{
    ViewData["Title"] = "Request Details";
}

<h1>Request #@Model.Id</h1>
<dl class="row">
    <dt class="col-sm-3">Employee</dt><dd class="col-sm-9">@Model.User.FullName (@Model.User.Email)</dd>
    <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.RequestDate.ToLocalTime()</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Total</dt><dd class="col-sm-9">@Model.TotalPrice.ToString("C")</dd>
</dl>

<table class="table table-bordered">
    <thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th>Subtotal</th></tr></thead>
    <tbody>
        @foreach (var item in Model.RequestItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@((item.Price * item.Quantity).ToString("C"))</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">Back</a>
