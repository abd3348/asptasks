@model task6.Models.ViewModels.SupplyRequestFormViewModel

<table class="table table-bordered align-middle">
    <thead>
        <tr><th>Product</th><th>Price</th><th>Available</th><th style="width:160px">Requested Quantity</th></tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Products.Count; i++)
        {
            <tr>
                <td>
                    @Model.Products[i].Name
                    <input asp-for="Products[i].ProductId" type="hidden" />
                </td>
                <td>@Model.Products[i].Price.ToString("C")</td>
                <td>@Model.Products[i].AvailableQuantity</td>
                <td>
                    <input asp-for="Products[i].Quantity" class="form-control" min="0" max="@Model.Products[i].AvailableQuantity" />
                    <span asp-validation-for="Products[i].Quantity" class="text-danger"></span>
                </td>
            </tr>
        }
    </tbody>
</table>
