@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
    var canManage = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Add Product</a>
    }
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Available Quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Quantity</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info btn-sm">Details</a>
                    @if (canManage)
                    {
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                            <button class="btn btn-outline-danger btn-sm" type="submit"
                                    onclick="return confirm('Delete this product?')">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
