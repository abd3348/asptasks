@model Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>@Model.Name</h1>
<dl class="row">
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("C")</dd>
    <dt class="col-sm-3">Available Quantity</dt><dd class="col-sm-9">@Model.Quantity</dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@(Model.Category?.Name ?? "-")</dd>
    <dt class="col-sm-3">Supplier</dt><dd class="col-sm-9">@(Model.Supplier?.Name ?? "-")</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>
